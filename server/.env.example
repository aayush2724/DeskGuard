# ── DeskGuard API configuration ────────────────────────────────
# Copy to server/.env for local development. In production set these in your
# host's dashboard (e.g. Render → Environment). NEVER commit real values.

PORT=3001
NODE_ENV=development

# PostgreSQL & Redis connection strings (docker-compose exposes these locally)
DATABASE_URL=postgresql://deskguard:changeme@localhost:5444/deskguard
REDIS_URL=redis://:changeme@localhost:6399

# Desk timers (seconds). Keep the client's VITE_AWAY_MINUTES / VITE_SESSION_HOURS in sync.
AWAY_TTL_SECONDS=1200
CHECKIN_TTL_SECONDS=7200

# Exact browser origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:6111,http://localhost:3001
# Optional regex for preview deployments, e.g. ^https://deskguard-[a-z0-9]+-yourteam\.vercel\.app$
ALLOWED_ORIGIN_PATTERN=

# Public website URL. Printed QR codes link here (NOT to the API host).
PUBLIC_SITE_URL=http://localhost:6111

# Staff key for the librarian dashboard. Must be 16+ characters and not a placeholder,
# otherwise staff endpoints are disabled. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
LIBRARIAN_API_KEY=

# Delete activity-log entries older than this many days (0 = keep forever)
ACTIVITY_LOG_RETENTION_DAYS=90

# Number of reverse-proxy hops to trust for client IPs (Render: 1)
TRUST_PROXY=1

# Per-IP limits. Students on one campus network often share a single public IP,
# so keep these generous. (Defaults: 600 req/min, 120 writes/min, 200 live streams)
RATE_LIMIT_PER_MIN=600
WRITE_RATE_LIMIT_PER_MIN=120
SSE_MAX_PER_IP=200
SSE_MAX_CONNECTIONS=1000
